+
+// ---- omxpert-mojo: when OMX_LIB is set, the routed MoE of one-token (decode) batches is computed by libomxmoe.so,
+// the Mojo expert layer (hot experts in VRAM pools from the owner's profile, cold experts on a CPU worker pool, CPU and
+// GPU bit-identical). Prompts keep llama.cpp's own path. OMX_MODEL / OMX_PINS: omxpert-mojo/results/model.txt, pins.bin
+#include <dlfcn.h>
+namespace {
+struct omx_api {
+    void *  lib   = nullptr;
+    int64_t h     = 0;
+    bool    tried = false;
+    int32_t (*moe)(int64_t, int32_t, const float *, float *) = nullptr;
+    int32_t (*moe_batch)(int64_t, int32_t, const float *, float *, int32_t) = nullptr;   // optional: batched path
+    int32_t (*moe_stream)(int64_t, int32_t, const float *, float *, void *) = nullptr;    // optional: on llama's CUDA stream
+    int32_t (*layer_gpu)(int64_t, int32_t) = nullptr;
+};
+omx_api & omx() { static omx_api a; return a; }
+void omx_op(ggml_tensor * dst, int ith, int nth, void * userdata);
+// OMX_STREAM=1: one-token nodes run on the CUDA backend: the Mojo kernels are enqueued on llama.cpp's own stream, so a
+// layer's experts never stop the GPU for the CPU (the cold experts still go to the CPU pool through the mailbox)
+struct omx_custom_params { ggml_custom_op_t fun; int n_tasks; void * userdata; };   // = ggml_custom_op_params (ggml-impl.h)
+int omx_stream_fn(void * stream, int device, ggml_tensor * dst) {
+    const int32_t il = (int32_t) (intptr_t) ((const omx_custom_params *) dst->op_params)->userdata;
+    const ggml_tensor * x = dst->src[0];
+    if (dst->ne[1] != 1 || x->type != GGML_TYPE_F32 || omx().layer_gpu(omx().h, il) != device) {
+        return 1;
+    }
+    if (stream == nullptr) {
+        return 0;
+    }
+    return omx().moe_stream(omx().h, il, (const float *) x->data, (float *) dst->data, stream);
+}
+bool omx_ready() {
+    omx_api & a = omx();
+    if (a.tried) {
+        return a.h != 0;
+    }
+    a.tried = true;
+    const char * path = getenv("OMX_LIB");
+    if (path == nullptr) {
+        return false;
+    }
+    a.lib = dlopen(path, RTLD_NOW | RTLD_GLOBAL);
+    if (a.lib == nullptr) {
+        LLAMA_LOG_ERROR("omx: dlopen(%s) failed: %s\n", path, dlerror());
+        return false;
+    }
+    auto init = (int64_t (*)(const char *, const char *)) dlsym(a.lib, "omx_init");
+    a.moe = (int32_t (*)(int64_t, int32_t, const float *, float *)) dlsym(a.lib, "omx_moe");
+    if (getenv("OMX_NOBATCH") == nullptr) {
+        a.moe_batch = (int32_t (*)(int64_t, int32_t, const float *, float *, int32_t)) dlsym(a.lib, "omx_moe_batch");
+    }
+    if (init == nullptr || a.moe == nullptr) {
+        LLAMA_LOG_ERROR("omx: omx_init/omx_moe not found in %s\n", path);
+        return false;
+    }
+    a.h = init(getenv("OMX_MODEL"), getenv("OMX_PINS"));
+    LLAMA_LOG_INFO("omx: Mojo expert layer %s\n", a.h != 0 ? "ready" : "FAILED to start");
+    if (a.h != 0 && getenv("OMX_STREAM") != nullptr && strcmp(getenv("OMX_STREAM"), "0") != 0) {
+        a.moe_stream = (int32_t (*)(int64_t, int32_t, const float *, float *, void *)) dlsym(a.lib, "omx_moe_stream");
+        a.layer_gpu  = (int32_t (*)(int64_t, int32_t)) dlsym(a.lib, "omx_layer_gpu");
+        ggml_backend_reg_t reg = ggml_backend_reg_by_name("CUDA");
+        typedef int (*stream_fn_t)(void *, int, ggml_tensor *);
+        auto set = reg ? (void (*)(ggml_custom_op_t, stream_fn_t)) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_set_custom_stream_op") : nullptr;
+        if (set != nullptr && a.moe_stream != nullptr && a.layer_gpu != nullptr) {
+            set(omx_op, omx_stream_fn);
+            LLAMA_LOG_INFO("omx: one-token layers run on llama.cpp's CUDA stream\n");
+        } else {
+            LLAMA_LOG_ERROR("omx: OMX_STREAM set but the CUDA stream hook or omx_moe_stream is missing\n");
+        }
+    }
+    return a.h != 0;
+}
+void omx_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    (void) nth;
+    if (ith != 0) {
+        return;
+    }
+    const int32_t il = (int32_t) (intptr_t) userdata;
+    const ggml_tensor * x = dst->src[0];
+    // OMX_NULLOP (timing only): keep the CPU stop per layer, skip the expert work, to measure what the stop costs
+    static const bool nullop = getenv("OMX_NULLOP") != nullptr;
+    if (nullop) {
+        memset(dst->data, 0, ggml_nbytes(dst));
+        return;
+    }
+    if (dst->ne[1] > 1 && omx().moe_batch != nullptr && x->nb[1] == (size_t) x->ne[0]*sizeof(float) && dst->nb[1] == (size_t) dst->ne[0]*sizeof(float)) {
+        omx().moe_batch(omx().h, il, (const float *) x->data, (float *) dst->data, (int32_t) dst->ne[1]);
+        return;
+    }
+    for (int64_t t = 0; t < dst->ne[1]; ++t) {
+        omx().moe(omx().h, il, (const float *) ((const char *) x->data + t*x->nb[1]), (float *) ((char *) dst->data + t*dst->nb[1]));
+    }
+}
