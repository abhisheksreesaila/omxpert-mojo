+// omxpert-mojo: an external library may run chosen GGML_OP_CUSTOM nodes on the CUDA stream itself (no CPU split).
+// cpu_fun identifies the nodes (ggml_custom_op_params.fun); fn(stream, device, dst) enqueues the work on stream and
+// returns 0, or with stream == nullptr only answers whether it can run this node on this device (0 = yes).
+typedef int (*ggml_cuda_custom_stream_fn)(void * stream, int device, struct ggml_tensor * dst);
+static ggml_custom_op_t           g_omx_cpu_fun = nullptr;
+static ggml_cuda_custom_stream_fn g_omx_fn      = nullptr;
+static void ggml_backend_cuda_set_custom_stream_op(ggml_custom_op_t cpu_fun, ggml_cuda_custom_stream_fn fn) {
+    g_omx_cpu_fun = cpu_fun;
+    g_omx_fn      = fn;
+}
+static bool ggml_cuda_custom_on_stream(const ggml_tensor * op, int device) {
+    if (g_omx_fn == nullptr || op->op != GGML_OP_CUSTOM) {
+        return false;
+    }
+    const ggml_custom_op_params * p = (const ggml_custom_op_params *) op->op_params;
+    return p->fun == g_omx_cpu_fun && g_omx_fn(nullptr, device, (ggml_tensor *) op) == 0;
+}
